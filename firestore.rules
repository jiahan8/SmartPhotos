rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default. More specific matches below can still
    // grant access (Firestore rules are OR'd together per request).
    match /{document=**} {
      allow read, write: if false;
    }

    // Top-level "note" collection is unused by the app (notes live under
    // user/{userId}/note below); locked down rather than left wide open to
    // any signed-in user.
    match /note/{noteId} {
      allow read, write: if false;
    }

    function isOwner(userId) {
      return request.auth != null && request.auth.uid == userId;
    }

    // Per-user data and the user's notes subcollection
    // (matches the user/{userId}/note/{noteId} path used by Cloud Functions).
    // Reads stay open to any signed-in user (needed to show note authors'
    // username/profile picture); writes are owner-only.
    // display_name is written directly by the client (not via a Cloud
    // Function), so its length cap is enforced here to match
    // MAX_DISPLAY_NAME_LENGTH in AppConstants.kt/functions/index.js.
    function isValidDisplayName() {
      return !("display_name" in request.resource.data) ||
          request.resource.data.display_name == null ||
          (request.resource.data.display_name is string &&
           request.resource.data.display_name.size() <= 50);
    }

    // fcm_token is written directly by the client when it registers for
    // push notifications, so its shape/length is validated here the same
    // way display_name is above.
    function isValidFcmToken() {
      return !("fcm_token" in request.resource.data) ||
          request.resource.data.fcm_token == null ||
          (request.resource.data.fcm_token is string &&
           request.resource.data.fcm_token.size() <= 4096);
    }

    match /user/{userId} {
      allow read: if request.auth != null;
      allow write: if isOwner(userId) && isValidDisplayName() && isValidFcmToken();

      // Notes are created via the createNote Cloud Function (Admin SDK,
      // bypasses these rules), which enforces MAX_POST_TEXT_LENGTH and
      // stamps the true owner into user_id -- so there is no client `create`
      // rule here at all. Clients may only flip `favorite` on an existing
      // note; every other field (text/media_list/user_id/created) must stay
      // exactly as it was, since generatedText/generatedObjects/
      // generatedLabels on media_list items may only be added by the
      // processTextRecognition Cloud Function.
      function onlyFavoriteChanged() {
        return request.resource.data.diff(resource.data).affectedKeys()
            .hasOnly(["favorite"]);
      }

      match /note/{noteId} {
        allow read: if request.auth != null;
        allow update: if isOwner(userId) && onlyFavoriteChanged();
        allow delete: if isOwner(userId);
      }

      match /archive/{noteId} {
        // Archived notes are written exclusively by the archiveDeletedNote
        // Cloud Function (Admin SDK, bypasses these rules) when a note is
        // deleted, so deleted notes are recoverable rather than
        // permanently destroyed. No client read/write path exists yet,
        // so this stays fully locked down, matching username/{username}
        // below.
        allow read, write: if false;
      }
    }

    // Username reservations back the uniqueness check in the
    // createUserProfile/updateUsername Cloud Functions. Fully locked down:
    // the isUsernameAvailable callable reads this via the Admin SDK (which
    // bypasses these rules), so clients never need direct access.
    match /username/{username} {
      allow read, write: if false;
    }
  }
}