rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // Deny everything by default. More specific matches below can still
    // grant access (Firestore rules are OR'd together per request).
    match /{document=**} {
      allow read, write: if false;
    }

    // Top-level notes: only signed-in users.
    match /note/{noteId} {
      allow read, write: if request.auth != null;
    }

    // Per-user data and the user's notes subcollection
    // (matches the user/{userId}/note/{noteId} path used by Cloud Functions).
    match /user/{userId} {
      allow read, write: if request.auth != null;

      match /note/{noteId} {
        allow read, write: if request.auth != null;
      }
    }

    // Members are publicly readable, but only signed-in users can write.
    match /member/{memberId} {
      allow read: if true;
      allow write: if request.auth != null;
    }
  }
}