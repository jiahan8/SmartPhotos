rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // Owner-scoped: a signed-in user may only read/write objects under
    // <folder>/<their-uid>/**. Files are uploaded as `<folder>/<uid>/<file>`,
    // so the second path segment must match the caller's uid.
    // Note: previously issued tokenized download URLs remain publicly fetchable
    // and are unaffected by these rules.
    match /{folder}/{userId}/{allPaths=**} {
      allow read, write: if request.auth != null && request.auth.uid == userId;
    }
  }
}